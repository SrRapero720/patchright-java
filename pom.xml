<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>cc.marbro.patchright</groupId>
    <artifactId>patchright-java-parent</artifactId>
    <version>1.64.0</version>
    <packaging>pom</packaging>

    <name>Patchright Java Parent</name>

    <modules>
        <!-- patch Microsoft playwright-java   -->
        <module>patchright-java-patcher</module>
        <!-- 对 patchright-java 进行测试 -->
        <module>patchright-java-test</module>
        <!-- 辅助使用 playwright-java / patchright-java   -->
        <module>patchright-java-assist</module>
    </modules>

    <properties>
        <maven.compiler.source>8</maven.compiler.source>
        <maven.compiler.target>8</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!---->
        <javaparser.version>3.26.4</javaparser.version>
        <junit.jupiter.version>5.10.2</junit.jupiter.version>

        <!-- This version property will be injected dynamically via CI/CD test script. Default is for internal IDE resolution if possible -->
        <!-- scripts/test_stealth.sh  >> -Dpatchright.version=$PATCHED_VERSION -->
        <patchright.version>${project.version}</patchright.version>
    </properties>

    <!-- 动态包含 release 模块（仅在其生成后才生效，避免初次 clone 时报错） -->
    <profiles>
        <profile>
            <id>release-module</id>
            <activation>
                <file>
                    <exists>patchright-java-release/pom.xml</exists>
                </file>
            </activation>
            <modules>
                <!-- the real patchright-java,  build by patchright-java-patcher -->
                <module>patchright-java-release</module>
            </modules>
        </profile>
    </profiles>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.github.javaparser</groupId>
                <artifactId>javaparser-core</artifactId>
                <version>${javaparser.version}</version>
            </dependency>
            <dependency>
                <groupId>cc.marbro.patchright</groupId>
                <artifactId>patchright</artifactId>
                <version>${patchright.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>
        </plugins>
    </build>

</project>
